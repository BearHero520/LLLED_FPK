#!/bin/bash
APP_ROOT="${TRIM_APPDEST:-/var/apps/App.Native.UGreenLED}"
VAR_DIR="${TRIM_PKGVAR:-${APP_ROOT}/var}"
CLI_URL="https://github.com/miskcoo/ugreen_leds_controller/releases/download/v0.1-debian12/ugreen_leds_cli"

SERVER_DIR=""
for d in "${APP_ROOT}/server" "${APP_ROOT}/target/server"; do
    [[ -f "${d}/led_daemon.sh" ]] && SERVER_DIR="$d" && break
done
SERVER_DIR="${SERVER_DIR:-${APP_ROOT}/server}"

mkdir -p "${VAR_DIR}/log" "${VAR_DIR}/led_cache" "${VAR_DIR}/disk_io"
for BIN_DIR in "${SERVER_DIR}/bin" "${APP_ROOT}/target/server/bin"; do
    mkdir -p "$BIN_DIR"
    if [[ ! -x "${BIN_DIR}/ugreen_leds_cli" ]]; then
        wget -q -O "${BIN_DIR}/ugreen_leds_cli" "$CLI_URL" 2>/dev/null || \
        curl -fsSL -o "${BIN_DIR}/ugreen_leds_cli" "$CLI_URL" 2>/dev/null || true
        chmod +x "${BIN_DIR}/ugreen_leds_cli" 2>/dev/null || true
    fi
done

if command -v apt-get >/dev/null 2>&1; then
    apt-get install -y -qq i2c-tools hdparm iproute2 2>/dev/null || true
fi
modprobe i2c-dev 2>/dev/null || true

if [[ ! -f "${VAR_DIR}/settings.conf" && -f "${SERVER_DIR}/default_settings.conf" ]]; then
    cp "${SERVER_DIR}/default_settings.conf" "${VAR_DIR}/settings.conf"
fi

if [[ -f "${SERVER_DIR}/led_daemon.sh" ]]; then
    bash "${SERVER_DIR}/led_daemon.sh" remap 2>/dev/null || true
fi

chmod +x "${SERVER_DIR}/"*.sh "${SERVER_DIR}/lib/"*.sh 2>/dev/null || true
chmod +x "${APP_ROOT}/ui/"*.cgi 2>/dev/null || true
chmod +x "${APP_ROOT}/cmd/"* 2>/dev/null || true

"${APP_ROOT}/cmd/main" start 2>/dev/null || true
exit 0
