#!/bin/bash
APP_NAME="App.Native.UGreenLED"
APP_ROOT="${TRIM_APPDEST:-/var/apps/${APP_NAME}}"
VAR_DIR="${TRIM_PKGVAR:-${APP_ROOT}/var}"

# 解析 server 目录（兼容 @appcenter 与 /var/apps/.../target 两种布局）
SERVER_DIR=""
for d in "${APP_ROOT}/server" "${APP_ROOT}/target/server"; do
    if [[ -f "${d}/led_daemon.sh" ]]; then
        SERVER_DIR="$d"
        break
    fi
done
SERVER_DIR="${SERVER_DIR:-${APP_ROOT}/server}"
source "${SERVER_DIR}/lib/app_paths.sh"
ugreen_resolve_runtime || exit 1

export APP_ROOT VAR_DIR RUNTIME_DIR SERVER_DIR TARGET="${APP_ROOT}"

SETTINGS_FILE="${VAR_DIR}/settings.conf"
UGREEN_CLI=""
for c in "${SERVER_DIR}/bin/ugreen_leds_cli" "${APP_ROOT}/target/server/bin/ugreen_leds_cli" /usr/bin/ugreen_leds_cli; do
    [[ -x "$c" ]] && UGREEN_CLI="$c" && break
done
export SETTINGS_FILE UGREEN_CLI LED_API_CACHE_DIR="${RUNTIME_DIR}/led_cache"
source "${SERVER_DIR}/lib/settings.sh"
source "${SERVER_DIR}/lib/hardware_profile.sh"
source "${SERVER_DIR}/lib/driver_manager.sh"
source "${SERVER_DIR}/lib/led_api.sh"
settings_init "$SETTINGS_FILE"

case "$1" in
start)
    modprobe i2c-dev 2>/dev/null || true
    mkdir -p "${VAR_DIR}/log" "$RUNTIME_DIR"
    configured_backend=$(led_backend_configured)
    if [[ "$configured_backend" != "cli" ]] && driver_managed_by_app && ! driver_sysfs_ready; then
        if driver_dkms_installed && driver_probe >> "${VAR_DIR}/log/driver.log" 2>&1; then
            led_backend_reset
        elif [[ "$configured_backend" == "sysfs" ]]; then
            # 内核升级后 DKMS/headers 可能暂时不可用；优先恢复内置 CLI，避免应用无法启动。
            settings_set "$SETTINGS_FILE" hardware backend cli
            led_backend_reset
            echo "实验驱动恢复失败，已安全回退到内置 CLI；请在 Web 页面重建驱动" >> "${VAR_DIR}/log/driver.log"
        fi
    fi
    if ! ensure_led_backend; then
        # fnOS 会把 start 的非零退出码当成安装失败。硬件或依赖暂时不可用时，
        # 仍允许应用和 Web 管理页启动，由守护进程持续重试并在页面显示诊断。
        echo "LED 控制后端暂不可用；应用继续启动，请在 Web 页面检查硬件与依赖" | \
            tee -a "${VAR_DIR}/log/driver.log" >&2
    fi
    bash "${SERVER_DIR}/led_daemon.sh" start
    exit 0
    ;;
stop)
    bash "${SERVER_DIR}/led_daemon.sh" stop 2>/dev/null
    # 清理由旧版本自动启动的独立 5088 API；Web 管理页实际使用 fnOS CGI。
    bash "${SERVER_DIR}/http_api.sh" stop 2>/dev/null
    exit 0
    ;;
status)
    bash "${SERVER_DIR}/led_daemon.sh" status 2>/dev/null
    exit $?
    ;;
*)
    exit 1
    ;;
esac
