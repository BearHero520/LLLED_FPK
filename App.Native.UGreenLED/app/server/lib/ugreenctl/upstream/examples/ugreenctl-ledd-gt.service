[Unit]
Description=UGREEN DXP2800 GT LED holder with explicit global flow takeover
After=systemd-udev-settle.service

[Service]
Type=simple
ExecStart=/usr/local/bin/ugreenctl-ledd --takeover-flow --force --apply
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run
PrivateTmp=true

[Install]
WantedBy=multi-user.target
