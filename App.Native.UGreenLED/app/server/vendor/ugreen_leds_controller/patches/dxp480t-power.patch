diff --git a/cli/dxp480t_power.cpp b/cli/dxp480t_power.cpp
new file mode 100644
index 0000000..e9153ac
--- /dev/null
+++ b/cli/dxp480t_power.cpp
@@ -0,0 +1,149 @@
+#include "dxp480t_power.h"
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <string>
+
+#include <unistd.h>
+
+namespace {
+
+constexpr const char *I2C_DEV_PATH = "/sys/class/i2c-dev";
+constexpr uint8_t N76E003_SIGNATURE_HIGH = 0xa5;
+constexpr uint8_t N76E003_SIGNATURE_LOW = 0xb5;
+
+std::string read_first_line(const std::filesystem::path &path) {
+    std::ifstream input(path);
+    std::string line;
+    std::getline(input, line);
+    return line;
+}
+
+std::string uppercase(std::string value) {
+    std::transform(value.begin(), value.end(), value.begin(), [](unsigned char c) {
+        return static_cast<char>(std::toupper(c));
+    });
+    return value;
+}
+
+} // namespace
+
+void dxp480t_power_t::set_error(const std::string &message) {
+    _last_error = message;
+}
+
+bool dxp480t_power_t::is_dxp480t_family() const {
+    static constexpr std::array<const char *, 2> product_paths = {
+        "/sys/class/dmi/id/product_name",
+        "/sys/devices/virtual/dmi/id/product_name",
+    };
+    for (const char *path : product_paths) {
+        const auto product = uppercase(read_first_line(path));
+        if (product.find("DXP480T") != std::string::npos) return true;
+    }
+    return false;
+}
+
+bool dxp480t_power_t::is_i801_adapter(const std::string &name) const {
+    return uppercase(name).find("SMBUS I801") != std::string::npos;
+}
+
+int dxp480t_power_t::start() {
+    namespace fs = std::filesystem;
+
+    _i2c.close();
+    _last_error.clear();
+    _bus_name.clear();
+    _address = 0;
+
+    if (!is_dxp480t_family()) {
+        set_error("DXP480T power protocol requires a DXP480T-family DMI product name");
+        return -1;
+    }
+    if (!fs::exists(I2C_DEV_PATH)) {
+        set_error("i2c-dev is unavailable: /sys/class/i2c-dev does not exist");
+        return -1;
+    }
+
+    for (const auto &entry : fs::directory_iterator(I2C_DEV_PATH)) {
+        if (!entry.is_directory()) continue;
+
+        auto adapter_name = read_first_line(entry.path() / "name");
+        if (adapter_name.empty()) adapter_name = read_first_line(entry.path() / "device" / "name");
+        if (!is_i801_adapter(adapter_name)) continue;
+
+        const auto bus = entry.path().filename().string();
+        const auto device = "/dev/" + bus;
+        for (const uint8_t address : { static_cast<uint8_t>(0x31), static_cast<uint8_t>(0x26) }) {
+            if (_i2c.start(device.c_str(), address) != 0) continue;
+
+            uint8_t high = 0;
+            uint8_t low = 0;
+            if (_i2c.read_byte_data(0x5a, high) == 0 &&
+                _i2c.read_byte_data(0x5b, low) == 0 &&
+                high == N76E003_SIGNATURE_HIGH && low == N76E003_SIGNATURE_LOW) {
+                _bus_name = bus;
+                _address = address;
+                return 0;
+            }
+        }
+    }
+
+    _i2c.close();
+    set_error("DXP480T N76E003 MCU not found on SMBus I801 (checked 0x31/0x26 for signature 0xa5b5)");
+    return -1;
+}
+
+int dxp480t_power_t::write_byte(uint8_t reg, uint8_t value) {
+    const int rc = _i2c.write_byte_data(reg, value);
+    if (rc != 0) {
+        std::ostringstream output;
+        output << "DXP480T N76E003 write failed at register 0x" << std::hex
+               << static_cast<int>(reg) << " value 0x" << static_cast<int>(value);
+        set_error(output.str());
+        return rc;
+    }
+
+    // The vendor driver performs sequential byte writes.  Retaining a small
+    // gap prevents a later write from being coalesced by an SMBus adapter.
+    usleep(30000);
+    return 0;
+}
+
+int dxp480t_power_t::set_power(color_t color, effect_t effect) {
+    if (_address == 0 && start() != 0) return -1;
+
+    // Community-verified sequence from miskcoo/ugreen_leds_controller#6:
+    // 0xa0 clears red and white selectors, 0xb1 chooses red(1)/white(2),
+    // 0x50 selects steady/fast/breath and 0x51 enables slow flash.
+    if (write_byte(0xa0, 1) != 0 || write_byte(0xa0, 2) != 0) return -1;
+
+    if (effect == effect_t::off) {
+        if (write_byte(0x50, 0) != 0 || write_byte(0x51, 0) != 0) return -1;
+        return write_byte(0xb1, 3);
+    }
+
+    if (write_byte(0x50, 0) != 0) return -1;
+    if (write_byte(0xb1, color == color_t::red ? 1 : 2) != 0) return -1;
+
+    if (effect == effect_t::slow) {
+        if (write_byte(0x50, 0) != 0) return -1;
+        return write_byte(0x51, 1);
+    }
+
+    if (write_byte(0x51, 0) != 0) return -1;
+    switch (effect) {
+        case effect_t::steady: return write_byte(0x50, 0);
+        case effect_t::fast: return write_byte(0x50, 1);
+        case effect_t::breath: return write_byte(0x50, 2);
+        case effect_t::off:
+        case effect_t::slow: break;
+    }
+
+    set_error("invalid DXP480T power effect");
+    return -1;
+}
