+#ifndef __UGREEN_DXP480T_POWER_H__
+#define __UGREEN_DXP480T_POWER_H__
+
+#include <cstdint>
+#include <string>
+
+#include "i2c.h"
+
+// The DXP480T family does not use the normal 0x3a RGB MCU.  Its power lamp is
+// controlled by an N76E003-compatible MCU on the SMBus I801 adapter.
+class dxp480t_power_t {
+public:
+    enum class color_t : uint8_t { red, white };
+    enum class effect_t : uint8_t { off, steady, fast, slow, breath };
+
+    int start();
+    int set_power(color_t color, effect_t effect);
+
+    const std::string &last_error() const { return _last_error; }
+    const std::string &bus_name() const { return _bus_name; }
+    uint8_t address() const { return _address; }
+
+private:
+    bool is_dxp480t_family() const;
+    bool is_i801_adapter(const std::string &name) const;
+    int write_byte(uint8_t reg, uint8_t value);
+    void set_error(const std::string &message);
+
+    i2c_device_t _i2c;
+    std::string _last_error;
+    std::string _bus_name;
+    uint8_t _address = 0;
+};
+
+#endif
