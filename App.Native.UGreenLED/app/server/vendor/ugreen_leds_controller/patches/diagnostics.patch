+
+static std::string read_adapter_name(const std::filesystem::path &entry) {
+    std::ifstream input(entry / "name");
+    std::string value;
+    std::getline(input, value);
+    if (!value.empty()) return value;
+
+    input.close();
+    input.open(entry / "device" / "name");
+    std::getline(input, value);
+    return value;
+}
+
+static std::string format_hex_bytes(const std::vector<uint8_t> &data) {
+    std::ostringstream output;
+    for (std::size_t i = 0; i < data.size(); ++i) {
+        if (i != 0) output << ' ';
+        output << std::hex << std::setfill('0') << std::setw(2)
+               << static_cast<int>(data[i]);
+    }
+    return output.str();
+}
