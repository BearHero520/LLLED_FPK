+           << " device=" << (_i2c.device_path().empty() ? "<unknown>" : _i2c.device_path())
+           << " address=0x" << std::hex << static_cast<int>(_i2c.address()) << std::dec
+           << " errno=" << _i2c.last_errno();
+    if (_i2c.last_errno() != 0) output << " (" << std::strerror(_i2c.last_errno()) << ")";
