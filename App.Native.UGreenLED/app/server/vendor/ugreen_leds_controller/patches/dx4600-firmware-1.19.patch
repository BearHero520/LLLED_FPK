+
+int i2c_device_t::read_word_data(uint8_t command, uint16_t &data) {
+    if (_fd < 0) { set_error("I2C_SMBUS_READ_WORD", EBADF); return -1; }
+    i2c_smbus_data value {};
+    i2c_smbus_ioctl_data request {};
+    request.size=I2C_SMBUS_WORD_DATA; request.read_write=I2C_SMBUS_READ;
+    request.command=command; request.data=&value;
+    if(ioctl(_fd,I2C_SMBUS,&request)<0) { set_error("I2C_SMBUS_READ_WORD",errno); return -1; }
+    data=value.word; clear_error();return 0;
+}
